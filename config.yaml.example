ipmi:
  username: ADMIN
  password: ADMIN

servers: []

discovery:
  bmh_url: "http://192.168.200.2:8082"
  namespace: "g11"  # filter BMH by namespace (empty = all namespaces)

reboot_detection:
  sol_patterns:
    - "POST"
    - "BIOS"
    - "Booting"
  chassis_poll_interval: 30s

logs:
  # MUST be a single-level path inside a mounted volume. The image is scratch:
  # /var does not exist, and RouterOS can only auto-create a ONE-level mount
  # target — so a PVC mounted at /var/lib/data silently does not appear, and
  # every SOL session then dies with "failed to create log dir: mkdir /var: no
  # such file or directory", losing all console history (issue #1).
  path: /data/logs
  retention_days: 30

server:
  port: 80
